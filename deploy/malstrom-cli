#!/bin/sh
# DarkSec MALSTROM — service + dashboard CLI (generated by install.sh)

MALSTROM_DIR="${MALSTROM_DIR:-__MALSTROM_DIR__}"

# shellcheck disable=SC1091
[ -r /etc/malstrom/env ] && . /etc/malstrom/env 2>/dev/null

STATE_DIR="${MALSTROM_STATE_DIR:-/var/lib/malstrom}"
DASH_PORT="${MALSTROM_DASH_PORT:-8888}"

export MALSTROM_STATE_DIR="${STATE_DIR}"
export MALSTROM_DASH_PORT="${DASH_PORT}"
export MALSTROM_DIR

usage() {
    cat <<EOF
usage: malstrom <command>

  start       start the daemon (prints URL + password)
  stop        stop the daemon
  restart     restart the daemon
  status      daemon status
  enable      enable + start at boot
  disable     remove boot autostart
  run         run in the foreground (debug)
  launch      ensure daemon is running, then open (logged-in) dashboard
  open        open the dashboard in the browser
  logs        follow the daemon log
  passwd      set / print the dashboard password
  wipe-loot   wipe the loot vault + data stores (keeps auth + config)
  reset       factory reset: loot, state, settings + auth wiped
  check       readiness report (touches nothing)
  uninstall   full uninstall (add --purge to delete loot too)
EOF
}

wait_token() {
    i=0
    while [ ! -r "${STATE_DIR}/token" ]; do
        sleep 0.5
        i=$((i + 1))
        [ "$i" -ge 20 ] && break
    done
    cat "${STATE_DIR}/token" 2>/dev/null
}

dash_port() {
    # The live port the daemon bound — it may have fallen back if the
    # configured one was taken (2888 etc.) — otherwise the configured default.
    if [ -r "${STATE_DIR}/dash.port" ]; then
        cat "${STATE_DIR}/dash.port" 2>/dev/null
    else
        echo "${DASH_PORT}"
    fi
}

cmd="${1:-}"
shift

case "$cmd" in
    start)
        systemctl start malstrom || exit 1
        tok=$(wait_token)
        echo
        echo "  MALSTROM is up."
        echo "  Dashboard : http://127.0.0.1:$(dash_port)"
        echo "  Password  : ${tok:-(none — daemon will generate one; see: malstrom passwd)}"
        echo
        ;;
    stop)    systemctl stop malstrom ;;
    restart) systemctl restart malstrom ;;
    status)  systemctl --no-pager status malstrom ;;
    enable)  systemctl enable --now malstrom ;;
    disable) systemctl disable --now malstrom ;;
    logs)    journalctl -u malstrom -f ;;
    launch)
        # Desktop launcher: mark the daemon as "app mode" so it starts clean
        # (idle, nothing armed) and fully shuts itself down once the dashboard
        # browser window is closed. The flag is dropped into the state dir
        # before the service starts; the daemon removes it when it exits.
        if ! systemctl is-active --quiet malstrom 2>/dev/null; then
            if [ "$(id -u)" = 0 ]; then
                { mkdir -p "${STATE_DIR}" 2>/dev/null; : > "${STATE_DIR}/.app-mode"; } \
                    && systemctl start malstrom || exit 1
            elif command -v pkexec >/dev/null 2>&1; then
                pkexec /bin/sh -c 'mkdir -p "$1" 2>/dev/null; : > "$1/.app-mode"; systemctl start malstrom' _ "${STATE_DIR}" || exit 1
            else
                echo "malstrom: daemon not running — run: sudo malstrom start" >&2
                exit 1
            fi
            i=0
            while ! systemctl is-active --quiet malstrom 2>/dev/null; do
                sleep 0.5
                i=$((i + 1))
                [ "$i" -ge 20 ] && break
            done
            sleep 1
        fi
        exec "$0" open
        ;;
    open)
        tok=""
        if ! systemctl is-active --quiet malstrom 2>/dev/null; then
            echo "malstrom: daemon not running — try: sudo malstrom start" >&2
        else
            tok=$(wait_token)
        fi
        if [ -n "$tok" ]; then
            echo "  Dashboard : http://127.0.0.1:$(dash_port)/#token=${tok}"
            echo "  Auto-signed-in (password also saved under /var/lib/malstrom/token)"
        fi
        url="http://127.0.0.1:$(dash_port)"
        [ -n "$tok" ] && url="${url}/#token=${tok}"
        xdg-open "$url" 2>/dev/null \
            || python3 -m webbrowser "$url" >/dev/null 2>&1
        ;;
    passwd|password|token)
        if [ "$#" -ge 1 ]; then
            pw="$1"
            [ ${#pw} -lt 4 ] && { echo "malstrom: password too short (min 4 characters)" >&2; exit 1; }
            set_tok() {
                PYTHONPATH="${MALSTROM_DIR}" python3 -c \
                    "import sys; from malstrom import state; state.set_token(sys.argv[1])" \
                    "$pw"
            }
            ok=
            if set_tok 2>/dev/null && [ "$(cat "${STATE_DIR}/token" 2>/dev/null)" = "$pw" ]; then
                ok=1
            elif [ "$(id -u)" != 0 ] && \
                 { sudo env PYTHONPATH="${MALSTROM_DIR}" MALSTROM_STATE_DIR="${STATE_DIR}" python3 -c \
                       "import sys; from malstrom import state; state.set_token(sys.argv[1])" \
                       "$pw" 2>/dev/null; } && \
                 [ "$(cat "${STATE_DIR}/token" 2>/dev/null)" = "$pw" ]; then
                ok=1
            fi
            [ -z "$ok" ] && { echo "malstrom: failed to write ${STATE_DIR}/token" >&2; exit 1; }
            echo "  Dashboard password set."
            echo "  Log in at http://127.0.0.1:$(dash_port) with: ${pw}"
        else
            tok=$(wait_token)
            if [ -n "$tok" ]; then
                echo "  Dashboard : http://127.0.0.1:$(dash_port)"
                echo "  Password  : $tok"
                echo "  (change it with: sudo malstrom passwd <newpassword>)"
            else
                echo "(no password yet — daemon not started: sudo malstrom start)"
            fi
        fi
        ;;
    wipe-loot|wipe)
        # The daemon's loot vault is /root/loot/malstrom (root-owned). A
        # non-root invocation would silently operate on an unrelated per-user
        # dir — escalate just like `passwd` does so the real vault is wiped.
        ok=
        if [ "$(id -u)" = 0 ]; then
            PYTHONPATH="${MALSTROM_DIR}" python3 -c \
                "from malstrom import state; state.ensure(); state.clear_loot(); state.reset_stores()" 2>/dev/null \
                && ok=1
        elif command -v sudo >/dev/null 2>&1; then
            sudo env PYTHONPATH="${MALSTROM_DIR}" python3 -c \
                "from malstrom import state; state.ensure(); state.clear_loot(); state.reset_stores()" 2>/dev/null \
                && ok=1
        fi
        if [ -n "$ok" ]; then
            echo "  Loot vault cleared (on-device data wiped)."
        else
            echo "malstrom: wipe failed (needs root) — try: sudo $0 wipe-loot" >&2
            exit 1
        fi
        ;;
    reset)
        running=0
        if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet malstrom 2>/dev/null; then
            systemctl stop malstrom || true
            running=1
        fi
        ok=
        if [ "$(id -u)" = 0 ]; then
            PYTHONPATH="${MALSTROM_DIR}" python3 -c \
                "from malstrom import state; state.ensure(); state.reset_all(preserve_auth=False)" 2>/dev/null \
                && ok=1
        elif command -v sudo >/dev/null 2>&1; then
            sudo env PYTHONPATH="${MALSTROM_DIR}" python3 -c \
                "from malstrom import state; state.ensure(); state.reset_all(preserve_auth=False)" 2>/dev/null \
                && ok=1
        fi
        if [ -n "$ok" ]; then
            echo "  MALSTROM factory reset (loot + state + password wiped)."
            if [ "$running" = 1 ] && command -v systemctl >/dev/null 2>&1; then
                systemctl start malstrom >/dev/null 2>&1 \
                    && echo "  Daemon restarted — new password: $(wait_token)"
            fi
        else
            echo "malstrom: reset failed (needs root) — try: sudo $0 reset" >&2
            exit 1
        fi
        ;;
    check)
        exec python3 "${MALSTROM_DIR}/bin/malstrom" --check
        ;;
    run)
        exec python3 "${MALSTROM_DIR}/bin/malstrom" "$@"
        ;;
    uninstall)
        shift
        if [ -x "${MALSTROM_DIR}/uninstall.sh" ]; then
            exec sudo "${MALSTROM_DIR}/uninstall.sh" "$@"
        else
            echo "run: sudo ${MALSTROM_DIR}/install.sh --uninstall" >&2
            exit 1
        fi
        ;;
    *)
        usage
        [ -z "$cmd" ] || exit 2
        ;;
esac