# DarkSec MALSTROM — runtime environment
# Loaded by the systemd service and the `malstrom` CLI.
# Uncomment an option and adjust to override the built-in default.

# MALSTROM_STATE_DIR=/var/lib/malstrom
# MALSTROM_LOOT_DIR=/root/loot/malstrom
# MALSTROM_DASH_PORT=8888
# MALSTROM_PORTAL_IP=172.16.52.1
# MALSTROM_PORTAL_PORT=80
# MALSTROM_DNS_PORT=1053
# MALSTROM_AUTH=1                   # uncomment to re-enable the token gate (off by default)
# MALSTROM_TOKEN=
# MALSTROM_DASH_TLS=1                # serve the operator dashboard over TLS
#                                     # (self-signed cert, generated once) so the
#                                     # token handshake never leaves in the clear
# MALSTROM_VAULT=1                   # encrypt the mirrored loot copy at rest
#                                     # (creds become *.vault Fernet blobs —
#                                     # needs python3-cryptography, else it
#                                     # stays plaintext + ALERT)
# MALSTROM_EXFIL_WEBHOOK=            # POST ALERT-class events (type/ts/msg —
#                                     # never loot) to this URL, fire-and-forget
#                                     # (alias: MALSTROM_WEBHOOK)
# MALSTROM_NOTIFY_DETAIL=0           # 1 includes action detail in webhook posts
# MALSTROM_DEAUTH_METHOD=auto
# MALSTROM_CAPTURE=handshake          # off|handshake|pmkid|both
# MALSTROM_KARMA=1                    # passive probe listen
# MALSTROM_KARMA_RESPOND=1            # opt-in PineAP-style probe responding
#                                     # (transmits — detectable; answers only
#                                     # broadcast/current-SSID probes)
# MALSTROM_KARMA_HOP=1                # idle karma sweeps all channels off-band
# MALSTROM_KARMA_HOP_DWELL=4          # seconds per channel while hopping
# MALSTROM_KARMA_HOP_CHANNELS=        # '1,6,11' overrides the band-wide plan
# MALSTROM_BEACON_FIDELITY=1          # replay the target's observed rate set /
#                                     # beacon interval / DTIM / HT hints into
#                                     # the twin's conf (sanitized, never fails
#                                     # the AP) so a beacon dump doesn't give
#                                     # the clone away by its radio signature
# MALSTROM_BEACON_ROTATE=0            # re-randomize the decoy BSSID every N
#                                     # minutes while armed (decoy mode only —
#                                     # cloning a target BSSID keeps it fixed)
# MALSTROM_SSID_CLOAK=0               # hide the twin's SSID broadcast
#                                     # (known clients still join via probes)
# MALSTROM_SHIELD=1                   # stop deauthing after cred capture
# MALSTROM_RELAY=0                    # 1 arms HTTP relay/SSL-strip-lite on
#                                     # boot (otherwise flip it in the UI after
#                                     # creds are captured); relaying forwards
#                                     # victim cleartext HTTP upstream and
#                                     # downgrades https links to http
# MALSTROM_CLIENT_ISOLATION=0         # 0 disables rogue-segment isolation
#                                     # (victims <-> victims / <-> your LAN)
# MALSTROM_FIREWALL=auto              # auto|iptables|nft — drive traffic
#                                     # redirect/isolation with iptables when
#                                     # present, else fall back to nftables
#                                     # (distros that ship only `nft` used to
#                                     # silently run with NO firewall)
# MALSTROM_IPV6_GUARD=1               # IPv6 is unserved on the rogue net:
#                                     # drop anything routed through the AP
#                                     # interface and pin v6 forwarding to 0
#                                     # for the engagement (restored after)
# MALSTROM_AP_IFACE=
# MALSTROM_MON_IFACE=
# MALSTROM_RECON_IFACE=
# MALSTROM_POLL=2

# --- post-exploitation ----------------------------------------------------
# MALSTROM_SCAN_BIN=nmap
# MALSTROM_SCAN_PORT_RANGE=1-1000     # default port-scan range
# MALSTROM_NETEXEC_BIN=netexec
# MALSTROM_SPRAY_LIMIT=15             # max cred*protocol attempts per spray
# MALSTROM_RESPONDER_BIN=responder
# MALSTROM_MITM_IFACE=                # default: the rogue AP interface
# MALSTROM_BEACON_INTERVAL=20         # agent call-home interval (seconds)